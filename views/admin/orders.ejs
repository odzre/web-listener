<%- include('../layouts/admin-start', { pageHeading: 'Transaksi', pageSubtitle: 'All orders', pageLead: 'Semua order lintas merchant dengan filter status dan region.' }) %>

<div class="card app-card">
  <div class="card-header flex-wrap gap-2">
    <div><h3 class="card-title">Semua transaksi</h3><div class="text-secondary small"><%= total %> hasil</div></div>
    <form class="filter-row ms-auto" method="get" action="/admin/orders">
      <input class="form-control form-control-sm" type="search" name="q" value="<%= filters.q %>" placeholder="Cari kode / merchant...">
      <select class="form-select form-select-sm" name="region">
        <option value="">Semua region</option>
        <option value="MY" <%= filters.region === 'MY' ? 'selected' : '' %>>Malaysia</option>
        <option value="ID" <%= filters.region === 'ID' ? 'selected' : '' %>>Indonesia</option>
      </select>
      <select class="form-select form-select-sm" name="status">
        <option value="">Semua status</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="success" <%= filters.status === 'success' ? 'selected' : '' %>>Sukses</option>
        <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
      </select>
      <button class="btn btn-sm btn-primary" type="submit"><i class="ti ti-filter"></i></button>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table table-vcenter app-table">
      <thead><tr><th>Referensi</th><th>Merchant</th><th>Region</th><th>Nominal</th><th>Status</th><th>Dibuat</th><th>Expired</th><th class="text-end">Aksi</th></tr></thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="8"><div class="empty-row"><i class="ti ti-receipt-off"></i><p>Tidak ada transaksi yang cocok.</p></div></td></tr>
        <% } %>
        <% orders.forEach((order) => { %>
          <tr>
            <td><a class="mono link-primary" href="/pay/<%= order.code %>"><%= order.code %></a></td>
            <td><div class="small fw-semibold"><%= order.userName %></div><div class="text-secondary" style="font-size:.72rem"><%= order.userEmail %></div></td>
            <td><span class="flag-mini flag-<%= order.region.toLowerCase() %>"><%= order.region %></span></td>
            <td class="fw-semibold"><%= order.formattedAmount %></td>
            <td><span class="badge bg-<%= helpers.statusClass(order.status) %>-lt"><%= helpers.statusLabel(order.status) %></span></td>
            <td class="text-secondary small"><%= helpers.datetime(order.createdAt) %></td>
            <td class="text-secondary small"><%= helpers.datetime(order.expiresAt) %></td>
            <td class="text-end">
              <% if (order.status === 'pending') { %>
                <div class="d-inline-flex gap-1">
                  <form method="post" action="/admin/orders/<%= order.id %>/status" data-confirm="Tandai order ini sukses secara manual?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="status" value="success">
                    <button class="btn btn-sm btn-outline-success" type="submit" title="Tandai sukses"><i class="ti ti-check"></i></button>
                  </form>
                  <form method="post" action="/admin/orders/<%= order.id %>/status" data-confirm="Tandai order ini expired?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="status" value="expired">
                    <button class="btn btn-sm btn-outline-secondary" type="submit" title="Tandai expired"><i class="ti ti-clock-x"></i></button>
                  </form>
                </div>
              <% } else { %>
                <span class="text-secondary small">-</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (total > 150) { %><div class="card-footer text-secondary small">Menampilkan 150 transaksi terbaru dari <%= total %> hasil.</div><% } %>
</div>

<%- include('../layouts/admin-end') %>
