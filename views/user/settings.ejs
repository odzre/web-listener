<%- include('../layouts/user-start', { pageHeading: 'Pengaturan', pageSubtitle: 'Account', pageLead: 'Kelola profil, keamanan, dan koneksi API Anda.' }) %>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card app-card mb-3">
      <div class="card-header"><h3 class="card-title">Profil</h3></div>
      <div class="card-body">
        <form method="post" action="/settings/profile">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="mb-3">
            <label class="form-label">Nama</label>
            <input class="form-control" type="text" name="name" value="<%= user.name %>" required minlength="2">
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" value="<%= user.email %>" required>
          </div>
          <button class="btn btn-primary" type="submit">Simpan profil</button>
        </form>
      </div>
    </div>

    <div class="card app-card">
      <div class="card-header"><h3 class="card-title">Keamanan</h3></div>
      <div class="card-body">
        <form method="post" action="/settings/password">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="mb-3">
            <label class="form-label">Password saat ini</label>
            <input class="form-control" type="password" name="current_password" required autocomplete="current-password">
          </div>
          <div class="mb-3">
            <label class="form-label">Password baru</label>
            <input class="form-control" type="password" name="new_password" required minlength="8" autocomplete="new-password">
          </div>
          <div class="mb-3">
            <label class="form-label">Konfirmasi password baru</label>
            <input class="form-control" type="password" name="confirm_password" required minlength="8" autocomplete="new-password">
          </div>
          <button class="btn btn-outline-secondary" type="submit">Perbarui password</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card app-card mb-3 integration-card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Koneksi aplikasi &amp; API</h3>
          <div class="text-secondary small">Gunakan data ini pada aplikasi Android dan integrasi server.</div>
        </div>
      </div>
      <div class="card-body">
        <div class="mb-4">
          <label class="form-label">API key</label>
          <div class="input-group">
            <input id="apiKeyField" class="form-control mono" type="password" value="<%= user.apiKey %>" readonly>
            <button class="btn btn-outline-secondary" type="button" data-password-toggle="#apiKeyField"><i class="ti ti-eye"></i></button>
            <button class="btn btn-outline-secondary" type="button" data-copy-value="#apiKeyField"><i class="ti ti-copy"></i></button>
          </div>
          <div class="form-hint">Jangan bagikan API key. Callback hanya memproses order milik akun ini.</div>
        </div>

        <div class="mb-4">
          <label class="form-label">URL callback</label>
          <div class="input-group">
            <input class="form-control mono" type="text" value="<%= callbackUrl %>" readonly>
            <button class="btn btn-outline-secondary" type="button" data-copy-text="<%= callbackUrl %>"><i class="ti ti-copy"></i></button>
          </div>
          <div class="form-hint">Tempel URL ini pada kolom callback di aplikasi Android.</div>
        </div>

        <div class="api-base">
          <div><span>Base URL</span><code><%= baseUrl %>/api/v1</code></div>
          <div><span>Create order</span><code>POST /create-order</code></div>
          <div><span>Check status</span><code>GET /check-status</code></div>
          <div><span>Callback</span><code>POST /callback</code></div>
        </div>

        <a href="/docs" class="btn btn-outline-secondary w-100 mt-3"><i class="ti ti-code"></i> Buka dokumentasi API</a>
      </div>
    </div>

    <div class="card app-card border-danger-subtle">
      <div class="card-header"><h3 class="card-title text-danger">Rotasi API key</h3></div>
      <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <p class="text-secondary mb-0 flex-grow-1">Membuat key baru akan mematikan key lama. Perbarui aplikasi Android setelah rotasi.</p>
        <form method="post" action="/settings/rotate-key" data-confirm="Rotasi API key sekarang? Key lama akan langsung tidak berlaku.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-danger" type="submit"><i class="ti ti-refresh"></i> Rotasi key</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/user-end') %>
