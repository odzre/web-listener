<!doctype html>
<html lang="id" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= pageTitle || site.siteTitle %></title>
  <meta name="description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) || site.siteDescription %>">
  <meta name="theme-color" content="#05070f">
  <% if (site.faviconUrl) { %>
    <link rel="icon" href="<%= site.faviconUrl %>">
  <% } else { %>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2306b6d4'/%3E%3Cpath d='M18 44V20h7l14 15V20h7v24h-7L25 29v15z' fill='%23050a14'/%3E%3C/svg%3E">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.50.0/dist/tabler-icons.min.css">
  <% if (typeof useTabler !== 'undefined' && useTabler) { %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.7.1/dist/css/tabler.min.css">
  <% } %>
  <link rel="stylesheet" href="/assets/css/app.css">
</head>
