# App
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Admin bootstrap (dibuat otomatis saat pertama kali dijalankan)
ADMIN_EMAIL=admin@notipay.local
ADMIN_PASSWORD=Admin#12345
ADMIN_NAME=Administrator

# Upstash Redis (wajib untuk production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (opsional, untuk logo/favicon/APK)
BLOB_READ_WRITE_TOKEN=

# Cron endpoint protection
CRON_SECRET=
